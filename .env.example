# Copy to .env for local development: cp .env.example .env
# MONGO_URI is set to the in-cluster mongo service in docker-compose.yml.

# --- api-common (Go) ---
JWT_SECRET=dev-secret-change-me
GOOGLE_CLIENT_ID=
BASE_URL=http://localhost:8080/

# --- api-observability (Python / ML insights) ---
MONGO_DB=Upstat
GROQ_API_KEY=
# Service-to-service gRPC auth token (generate via api/common/cmd/make_service_token).
# Leave blank to boot the stack; required for live cross-service gRPC calls.
UPSTAT_GRPC_AUTH_TOKEN=
UPSTAT_GRPC_CHECK_LIMIT=100

# --- web (build-time, inlined into the image) ---
NEXT_PUBLIC_BASE_URL=http://localhost:8080
# gRPC-Web endpoint (Envoy) as seen from the browser.
NEXT_PUBLIC_ENVOY_URL=http://localhost:8082
