# Copy to .env for local development: cp .env.example .env
# MONGO_URI is set to the in-cluster mongo service in docker-compose.yml.

# ── api-common (Go) ──
JWT_SECRET=dev-jwt-secret-change-me-0123456789ab
JWT_ACCESS_TTL=24h
SESSION_SECRET=dev-session-secret-change-me-0123456789
SESSION_COOKIE_NAME=upstat_session
OAUTH_STATE_COOKIE=upstat_oauth_state
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/sso/google/callback
# Web app origin the API redirects to after sign-in.
WEB_URL=http://localhost:3000
PUBLIC_URL=http://localhost:8080/

# ── api-observability (Python / ML insights) ──
MONGO_DB=Upstat
GROQ_API_KEY=
# Bearer token observability sends to api-common (generate via api/common/cmd/make_service_token).
# Leave blank to boot the stack; owner-scoped reads need it.
UPSTAT_API_TOKEN=
UPSTAT_API_CHECK_LIMIT=100
