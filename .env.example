# Copy to .env for local development: cp .env.example .env
# Everything has a working default in docker-compose.yml except Google
# sign-in, which needs an OAuth client (https://console.cloud.google.com).

# ── Sign-in (api/common) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google returns through the web's /api/v1 proxy.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/sso/google/callback
WEB_URL=http://localhost:3000
JWT_SECRET=dev-jwt-secret-change-me-0123456789ab
SESSION_SECRET=dev-session-secret-change-me-0123456789
JWT_ACCESS_TTL=24h

# ── Service-to-service off Cloud Run (common -> probe/query, analytics -> query) ──
INTERNAL_TOKEN=dev-internal-token-change-me

# ── Stores ──
POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=upstat_app
CLICKHOUSE_PASSWORD=clickhouse

# ── Monitoring private hosts (self-host only; cloud never does) ──
PROBE_ALLOW_PRIVATE=true

# ── Email alert channels (Brevo REST, X-7); empty = email deliveries fail and say so ──
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# ── Insight narratives: a BYO key for self-host (cloud uses Vertex AI) ──
GROQ_API_KEY=
GEMINI_API_KEY=
