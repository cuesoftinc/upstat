# Native-run config for api/analytics (compose users: the root .env instead).
PORT=8082
KAFKA_BROKERS=localhost:9092
STORAGE_DRIVER=s3
STORAGE_BUCKET=upstat
STORAGE_PREFIX=upstat/local
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio-secret
STORAGE_USE_SSL=false
CONTRACT_DIR=../common/contract
# Evaluator working state; empty keeps it in memory (one instance only).
REDIS_HOST=
QUERY_URL=http://localhost:8083
INTERNAL_TOKEN=dev-internal-token-change-me
WAKE_COMMON_URL=
# Brevo email channels (X-7); empty = email deliveries fail and say so.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
WEB_URL=http://localhost:3000
ALLOW_PRIVATE_WEBHOOKS=true
# Insight narrative: Vertex in cloud (GOOGLE_CLOUD_PROJECT), else a BYO key.
GOOGLE_CLOUD_PROJECT=
GROQ_API_KEY=
GEMINI_API_KEY=
# Cloud Scheduler guard for POST /internal/jobs/{evaluate,insights}.
SCHEDULER_AUDIENCE=
SCHEDULER_INVOKER_EMAIL=
WORKER_ENABLED=true
# POST /internal/settle: INTERNAL_TOKEN above, or on Cloud Run a Google ID token
# for this audience from one of these service accounts (comma separated).
INTERNAL_AUDIENCE=
INTERNAL_INVOKERS=
