# Native-run config for api/common (compose users: use the root .env instead).
PORT=8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=Upstat
JWT_SECRET=dev-secret-change-me
GOOGLE_CLIENT_ID=
BASE_URL=http://localhost:8080/
INSIGHT_SERVICE_GRPC_ADDRESS=localhost:50051
# CORS allowlist for the HTTP surfaces (api.md §1a).
CORS_ORIGINS=http://localhost:3000
# Cloud Scheduler OIDC guard for POST /internal/jobs/run-checks (unset returns 503).
SCHEDULER_AUDIENCE=
SCHEDULER_INVOKER_EMAIL=
# In-process monitor loop; set to false on Cloud Run (min instances 0), where the scheduler drives checks.
WORKER_ENABLED=true
