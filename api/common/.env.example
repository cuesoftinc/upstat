# Native-run config for api/common (compose users: use the root .env instead).
PORT=8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB=Upstat
JWT_SECRET=dev-jwt-secret-change-me-0123456789ab
JWT_ACCESS_TTL=24h
SESSION_SECRET=dev-session-secret-change-me-0123456789
SESSION_COOKIE_NAME=upstat_session
OAUTH_STATE_COOKIE=upstat_oauth_state
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/sso/google/callback
# Web app origin the API redirects to after sign-in.
WEB_URL=http://localhost:3000
PUBLIC_URL=http://localhost:8080/
# CORS allowlist for the HTTP surfaces (api.md §1a).
CORS_ORIGINS=http://localhost:3000
# Cloud Scheduler OIDC guard for POST /internal/jobs/run-checks (unset returns 503).
SCHEDULER_AUDIENCE=
SCHEDULER_INVOKER_EMAIL=
# In-process monitor loop; set to false on Cloud Run (min instances 0), where the scheduler drives checks.
WORKER_ENABLED=true
