# Native-run config for api/common against `docker compose up postgres clickhouse kafka seaweedfs`
# (compose users: use the root .env instead).
PORT=8080
DATABASE_URL=postgres://upstat_app:upstat_app@localhost:5432/upstat?sslmode=disable
CLICKHOUSE_URL=http://localhost:8123/?database=upstat
CLICKHOUSE_MIGRATE_USER=default
CLICKHOUSE_MIGRATE_PASSWORD=clickhouse
CLICKHOUSE_QUERY_USER=query_ro
KAFKA_BROKERS=localhost:9094
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL_CA=
STORAGE_DRIVER=s3
STORAGE_BUCKET=upstat
STORAGE_PREFIX=upstat/local
STORAGE_ENDPOINT=localhost:8333
STORAGE_ACCESS_KEY=upstat
STORAGE_SECRET_KEY=upstat-secret
STORAGE_USE_SSL=false
# Valkey for rate limits; unset turns limits off.
REDIS_HOST=
REDIS_PORT=6379
REDIS_KEY_PREFIX=upstat:
INTERNAL_TOKEN=dev-internal-token-change-me
JWT_SECRET=dev-jwt-secret-change-me-0123456789ab
JWT_ACCESS_TTL=24h
SESSION_SECRET=dev-session-secret-change-me-0123456789
SESSION_COOKIE_NAME=upstat_session
OAUTH_STATE_COOKIE=upstat_oauth_state
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/sso/google/callback
# Web app origin the API redirects to after sign-in.
WEB_URL=http://localhost:3000
# CORS allowlist for the HTTP surfaces (api.md §1a).
CORS_ORIGINS=http://localhost:3000
PROBE_URLS=local=http://localhost:8090
QUERY_URL=http://localhost:8083
OTLP_LOADER_ENDPOINT=
SELF_HOST=true
# Cloud Scheduler OIDC guard for POST /internal/jobs/run-checks (unset returns 503).
SCHEDULER_AUDIENCE=
SCHEDULER_INVOKER_EMAIL=
# In-process monitor loop; set to false on Cloud Run (min instances 0), where the scheduler drives checks.
WORKER_ENABLED=true
