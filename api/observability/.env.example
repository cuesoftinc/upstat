# Native (non-compose) run: cp .env.example .env, then npm run dev. Names
# follow docs/system-design.md §10.3; compose users rely on the root .env.
PORT=8081
# http = Express on PORT; grpc = OTLP/gRPC (h2c) on PORT (a Cloud Run
# service routes one port); both = Express on PORT plus gRPC on GRPC_PORT.
# Unset: both when GRPC_PORT is set, else http.
INGEST_TRANSPORT=both
GRPC_PORT=4317
# The private OpenTelemetry Collector that loads ClickHouse (one port).
OTLP_LOADER_ENDPOINT=http://localhost:4318
# Must exceed the collector's retry budget (8 s retries + 4 s attempt).
COLLECTOR_TIMEOUT_MS=15000
# Default byte quota per ingest key (S-11).
INGEST_BYTES_PER_SECOND=2000000
INGEST_MAX_BODY_BYTES=16777216
INGEST_MAX_CONCURRENT_BODIES=8
# A cached key or registry is rechecked against common's snapshot after this age.
CONFIG_MAX_AGE_SECONDS=30
# X-Forwarded-For: unset = on when K_SERVICE is set (Cloud Run). HOPS is how
# many proxies append (1 = the Google front end; 2 behind an external load balancer).
TRUST_PROXY_HEADERS=false
TRUST_PROXY_HOPS=1

# ── Kafka (config reloads only; compose: localhost:9094, no SASL) ──
KAFKA_BROKERS=localhost:9094
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SSL_CA=

# ── Object storage: gcs (cloud, ADC) | s3 (compose) ──
STORAGE_DRIVER=s3
STORAGE_BUCKET=upstat
STORAGE_PREFIX=upstat/local
STORAGE_ENDPOINT=localhost:8333
STORAGE_ACCESS_KEY=upstat
STORAGE_SECRET_KEY=upstat-secret
STORAGE_USE_SSL=false

# ── Valkey: quotas, daily salts, usage windows ──
# Empty host = in-memory state for one local process. Required (REDIS_REQUIRED
# unset) wherever REDIS_HOST or K_SERVICE is set: an outage answers 503.
REDIS_HOST=
REDIS_PORT=6379
REDIS_KEY_PREFIX=upstat:

# The JSON Schemas; the image copies them to /app/contract.
CONTRACT_DIR=../common/contract
